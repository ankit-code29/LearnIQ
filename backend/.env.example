# LearnIQ AI Learning Platform Environment Config

# Database
DATABASE_URL=sqlite:///learniq.db
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------
# Real AI LLM API Configuration
# -------------------------------------------------------------
# Choose "gemini" or "openai" (OpenAI-compatible APIs such as OpenRouter)
LLM_PROVIDER=gemini

# Google Gemini API
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI / OpenAI-Compatible (Groq, Ollama, DeepSeek, OpenRouter)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter example (set LLM_PROVIDER=openai when using this)
# Create a key at https://openrouter.ai/keys and use a currently available :free model.
OPENROUTER_API_KEY=
# OPENAI_MODEL=openrouter/free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
